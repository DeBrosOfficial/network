# Supply-chain hardening (engineering rules live in CLAUDE.md)
ignore-scripts=true
audit-level=moderate
auto-install-peers=false
strict-peer-dependencies=true
prefer-offline=true
save-exact=true
fund=false
update-notifier=false

# Project-specific: Gitea npm registry for the @orama-network scope.
@orama-network:registry=https://git.icxcnika.io/api/packages/ICXCNIKA/npm/
always-auth=true
# Reading a package from the Gitea registry needs a package-read token in your
# user ~/.npmrc: //git.icxcnika.io/api/packages/ICXCNIKA/npm/:_authToken=<token>.
# CI publishes with RELEASE_GITEA_TOKEN, written at job time (publish-sdk.yml),
# so none is referenced here.
