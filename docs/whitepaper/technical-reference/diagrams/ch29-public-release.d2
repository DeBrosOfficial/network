direction: down

dev: "push a version tag"
tag: "git tag vX.Y.Z or vX.Y.Z-nightly\ngit push to Gitea"
rel: ".gitea/workflows/release.yml"
chk: "strip v and -nightly;\nmust equal /VERSION"
gr: "GoReleaser: orama + orama-node,\nlinux/darwin, amd64/arm64,\ntar.gz, .deb, checksums.txt"
gtrel: "Gitea Release\n(prerelease: auto)"
arch: "archive job:\namd64 (global layer) + arm64 (cluster-only),\nreproducible, attached"
sdk: "publish-sdk job"
npm: "Gitea npm registry: @orama-network/orama, @orama-network/orama-vault\ndist-tag from prerelease suffix"
deb: "Gitea Debian registry: orama, orama-node\nstable/main, or nightly/main for a prerelease"

dev -> tag
tag -> rel
rel -> chk
chk -> gr: "equal"
chk -> tag: "differ: job fails" {
  style.stroke-dash: 3
}
gr -> gtrel
gtrel -> arch
rel -> sdk
gr -> deb
sdk -> npm
